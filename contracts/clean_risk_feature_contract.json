  "contract_version": "v1",
  "feature_semantics": {
    "LOC.localized_transition": "categorical key emitted only into the matching transition group, preserving V1 sparse semantics",
    "localized": "localized_transition equals the transition",
    "localized_invalid": "localized and decision=VERIFIER_INVALID",
    "localized_structural": "localized and decision=STRUCTURAL_MISSING",
    "missing_membership": "transition in required-but-not-present list",
    "raw_topology_membership": "transition in raw question-only topology prediction",
    "required": "membership in schema-constrained Expected Topology",
    "schema_topology_membership": "transition in schema-constrained topology prediction",
    "topology_probability": "question-only OOF/full-fit probability for T1-T4; no T5 probability because T5 is fixed required"
  },
  "flatten_contract": {
    "categorical_handling": "only DIAG.decision, LOC.decision, LOC.localized_reason, and matching LOC.localized_transition",
    "implementation": "explicit whitelist only; generic recursive flatten is forbidden",
    "list_handling": "only the explicitly named length/membership features may be emitted",
    "per_transition_verifier_numeric_fields_added": false,
    "unknown_input_fields": "ignore and audit-count; never auto-add"
  },
  "g0_general_only": {
    "allowed_sources": [
