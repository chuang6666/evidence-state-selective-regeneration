  "method_scope": "bug-fix and Dev/deployment alignment only; no method upgrade",
  "normalization": {
    "categorical_unknown": "DIAG.decision=UNKNOWN only when diagnosis decision is absent",
    "draft_tokens": "len(text_norm(draft_answer).split())",
    "evidence_chars": "len((title + single space + content).strip())",
    "missing_numeric": "omit sparse feature; never impute from Gold or split statistics",
    "modality_contract": "image/text/table only; all three keys emitted with integer 0 if absent",
    "question_tokens": "len(text_norm(question).split())",
    "text_norm": "NFKC; lowercase; replace non-[0-9a-z] runs with one space; trim"
  },
